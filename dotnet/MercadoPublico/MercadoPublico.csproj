<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <PackageId>MercadoPublico</PackageId>
    <Version>1.0.0</Version>
    <Authors>Jorge Luis Saraiva Ruas</Authors>
    <Description>Cliente de la API pública de Mercado Público (ChileCompra): licitaciones, órdenes de compra, convenios marco, Compra Ágil y quién compra / quién vende. Sin dependencias.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>chile;mercado-publico;chilecompra;licitaciones;compra-agil;convenio-marco</PackageTags>
    <RepositoryUrl>https://github.com/saraivaruas/mercado-publico-api</RepositoryUrl>
  </PropertyGroup>
</Project>
